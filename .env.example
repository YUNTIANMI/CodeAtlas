# ============================================================
# CodeAtlas 部署环境变量模板
#
# 使用方式：
#   cp .env.example .env
# 然后按需修改 .env。
#
# .env 已被 .gitignore 忽略，**不要**把真实密钥提交到仓库。
# 所有变量都带有默认值，不创建 .env 也能启动，但生产环境
# 至少应覆盖 MYSQL_ROOT_PASSWORD、JWT_SECRET、DEEPSEEK_API_KEY。
# ============================================================

# ---------------- 数据库 ----------------
# MySQL root 密码。同时作为后端连接数据库的密码。
MYSQL_ROOT_PASSWORD=root
# 数据库名
DB_NAME=codeatlas

# ---------------- 安全 ----------------
# JWT 签名密钥，HS256 要求至少 32 字节。
# 留空则使用 application.yml 内置占位密钥，后端启动时会打印告警。
# 生成方式示例（PowerShell）：
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=
# Token 有效期（秒），默认 2 小时
JWT_EXPIRATION=7200
# 跨域白名单，逗号分隔，禁止使用 *。
# 完整部署时前端与接口同源，此配置仅在直连后端调试时生效。
CORS_ALLOWED_ORIGINS=http://localhost:8081
# 登录连续失败多少次后锁定账号
LOGIN_MAX_ATTEMPTS=5
# 锁定时长（秒）
LOGIN_LOCK_SECONDS=900

# ---------------- AI ----------------
# DeepSeek API Key，用于问答 / 代码审查 / Git 摘要 / Agent。
# 不配置则这些功能不可用（向量化仍可用，因为走本地 Ollama）。
DEEPSEEK_API_KEY=
# 对话模型
AI_CHAT_PROVIDER=deepseek
AI_CHAT_MODEL=deepseek-chat
# 向量化模型：默认使用 compose 内的 Ollama 服务
AI_EMBEDDING_PROVIDER=ollama
AI_EMBEDDING_MODEL=bge-m3
# 维度必须与 Embedding 模型一致，更换模型后需清空知识库重建
AI_EMBEDDING_DIMENSION=1024
# 若改用宿主机上的 Ollama，把它设为 http://host.docker.internal:11434
AI_EMBEDDING_BASE_URL=http://ollama:11434

# ---------------- Git 集成（只读）----------------
# GitHub Personal Access Token，**强烈建议配置，公开仓库也建议配**。
# 不配置时走匿名调用，按出口 IP 限速 60 次/小时；用尽后同步提交、
# 生成摘要都会失败并报 403 rate limit exceeded（接口提示「获取提交列表失败」）。
# 注意额度消耗很快：导入仓库 1 次、同步 1 次、每生成一条提交摘要 1 次，
# 给 20 条提交做摘要就要 21 次，匿名额度一小时只够跑两轮。
# 配置后配额提升到 5000 次/小时。
# 公开仓库：fine-grained token，无需勾选任何权限即可。
# 私有仓库：fine-grained token 需勾选 Contents: Read-only。
# 生成入口：GitHub → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=

# ---------------- 端口 ----------------
# 前端 Nginx 对外端口
FRONTEND_PORT=8081
# 后端对外端口
BACKEND_PORT=8080

# ---------------- 对外访问（生产部署用）----------------
# 生产环境对外地址，供 Caddy 自动 HTTPS 使用（见 docs/deployment-vps.md）。
#   有域名：SITE_ADDRESS=codeatlas.example.com   （Caddy 自动签发/续期 HTTPS 证书）
#   无域名：SITE_ADDRESS=:80                     （仅 HTTP，访问 http://<服务器IP>）
# 仅在使用 docker-compose.prod.yml 时生效；本地开发可留空。
SITE_ADDRESS=

# ---------------- 前端构建（一般无需修改）----------------
# 留空表示前端与后端同源（由 Nginx 反向代理 /api），推荐保持默认。
# 仅在前后端分域部署时填写后端完整地址，如 https://api.example.com
VITE_API_BASE_URL=
